# Cloud Functions environment variables.
#
# Copy to .env (gitignored) for local emulator runs. In deployed
# environments these come from Secret Manager + the deploy config.
#
# T20 — text moderation
JACOB_TEXT_MODERATION_DAILY_CAP=5000
MODERATION_TEXT_DISABLED=false

# T28 — Typesense search sidecar.
# TYPESENSE_ADMIN_KEY is the WRITE key — never expose to the backend
# (which uses the read-only key) or the frontend.
TYPESENSE_HOST=
TYPESENSE_ADMIN_KEY=
TYPESENSE_COLLECTION=messages
JACOB_SEARCH_INDEX_DAILY_CAP=50000
TYPESENSE_DISABLED=false
