{
  "rules": {
    ".read": false,
    ".write": false,

    "memberships": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$gid": {
          ".write": "auth != null && auth.token.admin == true",
          ".validate": "newData.isBoolean() || newData.val() === null"
        }
      }
    },

    "presence": {
      "$gid": {
        ".read": "auth != null && root.child('memberships').child(auth.uid).child($gid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('memberships').child($uid).child($gid).exists()",
          ".validate": "newData.hasChildren(['lastSeenAt','status']) && newData.child('status').isString() && (newData.child('status').val() == 'online' || newData.child('status').val() == 'offline') && newData.child('lastSeenAt').isNumber()"
        }
      }
    },

    "typing": {
      "$gid": {
        ".read": "auth != null && root.child('memberships').child(auth.uid).child($gid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && root.child('memberships').child($uid).child($gid).exists()",
          ".validate": "newData.hasChildren(['startedAt']) && newData.child('startedAt').isNumber()"
        }
      }
    },

    "watch": {
      "$gid": {
        "$sessionId": {
          ".read": "auth != null && root.child('memberships').child(auth.uid).child($gid).exists()",
          ".write": "auth != null && root.child('memberships').child(auth.uid).child($gid).exists() && (!data.exists() || data.child('leaderUid').val() == auth.uid)",
          ".validate": "newData.hasChildren(['videoId','paused','positionSec','leaderUid','updatedAt']) && newData.child('leaderUid').val() == auth.uid"
        }
      }
    }
  }
}
