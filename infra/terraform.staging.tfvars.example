# Copy to terraform.staging.tfvars and fill in real values.
# terraform.staging.tfvars is gitignored — never commit it.
#
# project_id            — GCP project ID (e.g. jacob-staging-494515)
# env                   — short env label, used in resource names (staging | production)
# billing_account_id    — bare ID from `gcloud billing accounts list` (XXXXXX-XXXXXX-XXXXXX)
# github_org            — GitHub org or user that owns the repo (e.g. critterwilson)
# github_repo           — repo name without org prefix (e.g. jacob)
# backend_host          — Cloud Run URL or custom domain, no scheme (e.g. api.jacob.app)
# frontend_host         — Firebase Hosting or App Hosting URL, no scheme (e.g. jacob.app)
# *_service_account_email — SA emails for backend, backup job, and moderation pipeline.
#   The dedicated SAs are created by service_accounts.tf in this same module.
#   After the first `terraform apply`, copy the Terraform outputs into the
#   matching values below (jacob-api, jacob-moderation, jacob-backup).

project_id                       = "YOUR_PROJECT_ID"
env                              = "staging"
billing_account_id               = "XXXXXX-XXXXXX-XXXXXX"
github_org                       = "YOUR_GITHUB_ORG"
github_repo                      = "jacob"
backend_host                     = "YOUR_CLOUD_RUN_URL_OR_CUSTOM_DOMAIN"
frontend_host                    = "YOUR_FIREBASE_HOSTING_URL_OR_CUSTOM_DOMAIN"
api_service_account_email        = "jacob-api@YOUR_PROJECT.iam.gserviceaccount.com"
backup_service_account_email     = "jacob-backup@YOUR_PROJECT.iam.gserviceaccount.com"
moderation_service_account_email = "jacob-moderation@YOUR_PROJECT.iam.gserviceaccount.com"
alert_email                      = "YOUR_ALERT_EMAIL@example.com"
budget_email                     = "YOUR_ALERT_EMAIL@example.com"  # should match alert_email; used for billing budget alerts
billing_budget_usd               = 50                              # early-warning monthly budget; alerts at 50/90/100/120%

# ── $10 hard cap kill switch (billing-killswitch.tf) ─────────────────────────
# killswitch_cap_usd     — hard monthly cap; billing is DISABLED when actual spend hits it
# killswitch_project_ids — projects to unlink when the cap fires; empty = [project_id] (staging only)
# killswitch_dry_run     — true logs the intended disable without unlinking (use to test the wiring first)
killswitch_cap_usd               = 10
killswitch_project_ids           = []      # defaults to [project_id]; add "jacob-494515" to also cap prod
killswitch_dry_run               = false   # set true for a no-op rehearsal, then flip to false to arm
