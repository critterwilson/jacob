# Backend environment variables
# Copy to .env.local for local development (never commit .env.local)
#
# Firebase Admin SDK credentials are added in T03.
# See backend/README.md for the full list of required variables per task.

# T10 — photo upload + moderation pipeline.
# Bucket names (no `gs://` prefix). Production names are
# `jacob-media-{quarantine,public}-{env}`.
JACOB_MEDIA_QUARANTINE_BUCKET=
JACOB_MEDIA_PUBLIC_BUCKET=

# CSAM hash provider (C2). One of:
#   disabled     no-op, all uploads pass. Default in `development`.
#   noop         no-op + WARNING log per call (use in staging while
#                a hash service is being commissioned).
#   <URL>        POST `{"hash":"<sha256>"}` to that endpoint.
#
# Production deploys MUST set this explicitly. Leaving it unset in
# anything other than development raises and rejects uploads.
# `disabled` and `noop` mean uploads bypass scanning entirely — see
# docs/runbooks/csam-incident.md for the legal-exposure trade-off.
#
# JACOB_HASH_SERVICE_URL is the legacy URL-only var; still honoured
# when JACOB_HASH_PROVIDER is unset, so existing deploys keep working.
# JACOB_DISABLE_MODERATION=true short-circuits the entire pipeline
# (SafeSearch + hash) for local emulator runs.
JACOB_HASH_PROVIDER=
JACOB_HASH_SERVICE_URL=
JACOB_NCMEC_ENDPOINT=
JACOB_DISABLE_MODERATION=

# JACOB_NCMEC_SUBMIT_DISABLED (C3) — kill-switch on the auto-submit-to-
# NCMEC HTTPS path. Default true because the integration is not wired
# in v1; every detection becomes a "manual NCMEC submission required"
# entry in the operator queue (`/admin/ncmec`) and a CRITICAL log line.
# Flip to "false" only when the live integration ships.
JACOB_NCMEC_SUBMIT_DISABLED=true

# T18 — Transactional email via SendGrid
# API key from https://app.sendgrid.com/settings/api_keys
# Leave empty to skip email sending in local dev (a warning will be logged).
SENDGRID_API_KEY=
# Full RFC 5322 From address, e.g. "Olivet <noreply@yourdomain.com>"
EMAIL_SENDER=Olivet <noreply@yourdomain.com>
# Reply-To address that maps to an inbox you actually monitor
EMAIL_REPLY_TO=hello@yourdomain.com
# User-facing product name, injected into every transactional email as
# {{ brand_name }}. PROVISIONAL — mirror of frontend lib/brand.ts; keep
# in sync. Final Olive Branch rebrand name TBD (Olivet / Branch / Selah).
BRAND_NAME=Olivet

# T15 — Observability
# Sentry DSN from sentry.io project settings. Leave empty to disable Sentry.
SENTRY_DSN=
# One of: development | staging | production
SENTRY_ENVIRONMENT=development
# Fraction of transactions sent to Sentry for performance monitoring (0–1).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to true to enable /debug/* endpoints. Never set in production.
DEBUG=false

# ENVIRONMENT scopes the in-code defaults that fall back when CORS_ALLOWED_ORIGINS
# is empty: "development" gets http://localhost:3000; "staging"/"production"
# fall closed to []. Set ENVIRONMENT=staging|production on the deployed Cloud Run
# service; leave unset (or "development") locally.
# ENVIRONMENT=development

# Comma-separated list of origins allowed to call /api/* cross-origin.
# REQUIRED in staging and production (set on the Cloud Run service via the
# GitHub Environment secret CORS_ALLOWED_ORIGINS — see deploy.yml). Empty
# allowlist = no cross-origin requests, by design (PR6 / H4).
# CORS_ALLOWED_ORIGINS=https://example-preview.web.app,https://jacob.app

# Native Firestore search (ADR 0016). Setting JACOB_SEARCH_ENABLED=false
# short-circuits /api/search with 503 search_disabled.
JACOB_SEARCH_ENABLED=false

# T32 — cross-group message boards.
# Set to "true" once initial boards have been seeded
# (`python scripts/seed_boards.py`). The flag is reserved for future
# server-side gating (e.g. read-only mode during incident response);
# the rules path is always live.
JACOB_BOARDS_ENABLED=true

# T33 — Bible verse feed
# Leave BIBLE_API_BASE unset to use https://bible-api.com
# Set JACOB_VERSE_DISABLED=true to skip the daily fetch without error.
BIBLE_API_BASE=https://bible-api.com
JACOB_VERSE_TRANSLATION=web
JACOB_VERSE_DISABLED=false

# T35 — Weekly email digest + one-click unsubscribe
# HS256 secret used to sign unsubscribe JWT tokens. Rotate via Secret Manager.
# Warning: rotating this secret invalidates all in-flight tokens (users
# re-receive a fresh token on the next digest).
JWT_UNSUBSCRIBE_SECRET=
# Set to "true" to enable the weekly digest Cloud Run Job.
# Leave false until SendGrid DKIM/SPF is configured and BQ views exist (T29).
JACOB_DIGEST_ENABLED=false
# Set to "true" in local dev / CI to use the SendGrid sandbox (no actual sends).
SENDGRID_SANDBOX=false
# Users processed per batch before a 1-second sleep (default: 200).
DIGEST_BATCH_SIZE=200
# Public URL of the backend API — used for building unsubscribe links in emails.
API_URL=https://api.jacob.app

# T38 — Self-serve data export (GDPR DSAR)
# GCS bucket for export bundles, e.g. `jacob-exports-staging`. The
# bucket lifecycle deletes objects after 14 days; the signed URL TTL
# below is shorter. Leave unset in dev to disable export uploads.
JACOB_EXPORT_BUCKET=
# V4 signed URL validity window in days (default 7).
JACOB_EXPORT_SIGNED_URL_TTL_DAYS=7
# Kill-switch — set to `true` to make POST /api/account/export return 503
# without redeploying. Use in an outage where bundles are at risk of
# leaking foreign data.
JACOB_EXPORT_DISABLED=false

# M4 (account-deletion cascade) — Realtime Database URL. The
# finalize-account job reaches into RTDB to clean up
# `presence/{gid}/{uid}`, `typing/{gid}/{uid}`, and
# `watch/{gid}/{sessionId}` (where the leader is the deleted user).
# Empty disables the RTDB sweep with a single info log; the rest of
# finalize_account still runs.
# Example: https://jacob-staging-494515-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# M5 / ADR 0013 — SSE chat stream kill-switch. Set to `true` to make
# `GET /api/groups/{gid}/messages/stream` return 503 and force every
# client back to the 10s polling fallback. See
# docs/runbooks/realtime-messages.md.
JACOB_MESSAGES_STREAM_DISABLED=false

# Group meeting addresses — forward geocoding via OpenStreetMap Nominatim
# (no paid API key). The User-Agent is REQUIRED by Nominatim's usage
# policy and should identify this deployment + a contact. Geocoding only
# runs on address writes (lat/lng is cached on the group doc), so the
# ≤1 req/sec limit is fine. Point NOMINATIM_BASE_URL at a self-hosted
# instance for higher volume.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=JACOB/1.0 (+https://jacob.app)
