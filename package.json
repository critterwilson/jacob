{
  "name": "jacob",
  "private": true,
  "scripts": {
    "start": "pnpm --filter jacob-frontend start",
    "seed:stickers": "pnpm -F jacob-firestore seed:stickers",
    "seed:stickers:emulator": "pnpm -F jacob-firestore seed:stickers:emulator",
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "bash -c 'cd backend && uv run --extra dev black \"$@\"' --"
    ],
    "**/package.json": [
      "bash -c 'pnpm install && git add pnpm-lock.yaml'"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
