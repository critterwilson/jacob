# Firebase — copy values from Firebase console > Project Settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to route Firebase traffic through local emulators
# (Auth on :9099, Firestore on :8080). Leave unset for production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# T15 — Observability
# Sentry DSN from sentry.io project settings. Leave empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# One of: development | staging | production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Fraction of transactions sent to Sentry for performance monitoring (0–1).
# Defaults to 0.1 when unset.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# T34 — Web push via FCM.
# VAPID key from Firebase console > Project Settings > Cloud Messaging > Web Push certificates.
# Leave empty to disable push notification registration (app still works without it).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# T19 — Moderation reporting is now native (POST /api/reports).
# The Google Form variables (NEXT_PUBLIC_REPORT_FORM_ID, NEXT_PUBLIC_REPORT_ENTRY_*)
# are no longer used and have been removed; see docs/moderation-runbook.md.
