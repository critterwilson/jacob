# Firebase — copy values from Firebase console > Project Settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to route Firebase traffic through local emulators
# (Auth on :9099, Firestore on :8080). Leave unset for production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# T15 — Observability
# Sentry DSN from sentry.io project settings. Leave empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# One of: development | staging | production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# T12 — Moderation report form (Google Forms).
# See docs/moderation-runbook.md for how to find these IDs.
# When unset, the Report link is hidden/disabled in the UI.
NEXT_PUBLIC_REPORT_FORM_ID=
NEXT_PUBLIC_REPORT_ENTRY_CONTENT_TYPE=
NEXT_PUBLIC_REPORT_ENTRY_CONTENT_ID=
NEXT_PUBLIC_REPORT_ENTRY_GROUP_ID=
NEXT_PUBLIC_REPORT_ENTRY_REPORTER_UID=
NEXT_PUBLIC_REPORT_ENTRY_TIMESTAMP=
