rules_version = '2';

// JACOB Firestore security rules — M6 (data-layer migration, Phase F).
//
// As of M6, every read and write the frontend performs goes through the
// FastAPI backend's `/api/*` surface. The Admin SDK bypasses these
// rules; clients no longer talk to Firestore directly. The rules below
// therefore default to `allow read, write: if false;` on every
// previously-client-accessible path. The backend-only rules
// (moderation_queue, bans, audit_log, inviteCodes, uploads) are
// unchanged — they were already locked.
//
// The previous CG-members exception was removed in M6: Firestore rules
// can't differentiate a direct document read from a collection-group
// query at the rule level, so any allow-rule on the members path
// granted direct doc reads too. Admin tools should use the Admin SDK
// (which bypasses these rules anyway) — there is no surface that needs
// the CG read from a client now that `useGroups` calls
// `GET /api/users/me/groups`.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- users -----------------------------------------------------------
    // All reads/writes flow through `/api/users/me/*` (M2). The user doc,
    // private subcollection, mutes, blocks, devices, notification prefs,
    // and notifications inbox are all backend-mediated.
    match /users/{uid} {
      allow read, write: if false;

      match /private/{docId} {
        allow read, write: if false;
      }
      match /mutes/{otherUid} {
        allow read, write: if false;
      }
      match /blocks/{otherUid} {
        allow read, write: if false;
      }
      match /devices/{deviceId} {
        // Admin SDK cleanup job still runs against this collection; the
        // rule is kept for the auth.token.admin path so a misconfigured
        // admin key can't accidentally write either.
        allow read, write: if false;
      }
      match /notificationPrefs/{docId} {
        allow read, write: if false;
      }
      match /notifications/{nid} {
        allow read, write: if false;
      }
      match /exports/{jobId} {
        allow read, write: if false;
      }
    }

    // --- groups ----------------------------------------------------------
    // Group + members + messages + reactions + invites + joinRequests all
    // flow through the backend (M3 reads, M4 writes).
    match /groups/{gid} {
      allow read, write: if false;

      match /members/{uid} {
        allow read, write: if false;
      }
      match /messages/{mid} {
        allow read, write: if false;
      }
      match /messages/{mid}/reactions/{stickerSlug}/users/{uid} {
        allow read, write: if false;
      }
      match /joinRequests/{uid} {
        allow read, write: if false;
      }
      match /invites/{inviteId} {
        allow read, write: if false;
      }
    }

    // --- stickers / daily_verse / boards --------------------------------
    match /stickers/{sid} {
      allow read, write: if false;
    }

    match /daily_verse/{day} {
      allow read, write: if false;
    }

    match /boards/{boardId} {
      allow read, write: if false;

      match /posts/{postId} {
        allow read, write: if false;

        match /replies/{replyId} {
          allow read, write: if false;
        }

        match /reactions/{stickerSlug}/users/{uid} {
          allow read, write: if false;
        }
      }
    }

    // --- backend-only collections (unchanged from pre-migration) -------
    match /moderation_queue/{itemId} {
      allow read, write: if false;
    }
    match /bans/{uid} {
      allow read, write: if false;
    }
    match /audit_log/{eventId} {
      allow read, write: if false;
    }
    match /inviteCodes/{code} {
      allow read, write: if false;
    }
    match /uploads/{uploadId} {
      allow read, write: if false;
    }

    // --- T58 feature flags ----------------------------------------------
    // Read via `GET /api/flags` (server-evaluated for the caller); mutated
    // via `/api/admin/flags*` (platform-admin only). Direct client access
    // is denied per the M6 backend-mediated convention.
    match /feature_flags/{flagKey} {
      allow read, write: if false;
    }

    // --- default deny (defense in depth) --------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
